---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { devlogUrl, getPublishedDevlogs } from "@/lib/devlogs";
import { DEFAULT_LOCALE, type Locale } from "@/i18n";
import { messages } from "@/messages";

interface Props { locale?: Locale; }
const { locale = DEFAULT_LOCALE } = Astro.props;
const { nav, devlogs: copy } = messages[locale];
const posts = await getPublishedDevlogs(locale);
const categories = [...new Set(posts.flatMap((post) => post.data.categories))]
  .sort((a, b) => a.localeCompare(b, locale));
---
<BaseLayout title={nav.devlogs} description={copy.description} locale={locale} section="devlogs">
  <h1 class="section-heading">{nav.devlogs}</h1>
  <p class="section-intro">{copy.intro}</p>
  <div class="filter-bar" id="devlog-filters" hidden>
    <label for="category-filter">{copy.filter}</label>
    <select id="category-filter" class="category-select" disabled={categories.length === 0}>
      <option value="">{copy.all}</option>
      {categories.map((category) => <option value={category}>{category}</option>)}
    </select>
  </div>
  {posts.length === 0 ? (
    <div class="empty-state">
      <h2>{copy.empty}</h2>
    </div>
  ) : (
    <>
      <p id="filter-status" class="filter-status" role="status" aria-live="polite" data-one={copy.one} data-many={copy.many} data-in-category={copy.inCategory}></p>
      <ul class="devlog-list" id="devlog-list">
        {posts.map((post) => (
          <li class="devlog-entry" data-categories={JSON.stringify(post.data.categories)}>
            <article>
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString(locale, { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}</time>
                <span class="post-categories">{post.data.categories.map((category) => <span>{category}</span>)}</span>
              </div>
              <h2 class="devlog-title"><a href={devlogUrl(post)}>{post.data.title}</a></h2>
              <p class="devlog-summary">{post.data.description}</p>
            </article>
          </li>
        ))}
      </ul>
      <div class="empty-state" id="no-category-results" hidden><h2>{copy.noResults}</h2><p>{copy.chooseAnother}</p></div>
    </>
  )}
</BaseLayout>
<script>
  const controls = document.getElementById("devlog-filters");
  const select = document.getElementById("category-filter") as HTMLSelectElement | null;
  const entries = Array.from(document.querySelectorAll<HTMLElement>(".devlog-entry"));
  const status = document.getElementById("filter-status");
  const empty = document.getElementById("no-category-results");

  function filterFromUrl() {
    const category = new URL(window.location.href).searchParams.get("category") ?? "";
    if (select) {
      select.querySelector("[data-unavailable]")?.remove();
      const known = Array.from(select.options).some((option) => option.value === category);
      if (category && !known) {
        const option = new Option(category, category);
        option.dataset.unavailable = "true";
        select.add(option);
      }
      select.value = category;
    }
    let visible = 0;
    entries.forEach((entry) => {
      const categories: string[] = JSON.parse(entry.dataset.categories ?? "[]");
      entry.hidden = !!category && !categories.includes(category);
      if (!entry.hidden) visible++;
    });
    if (status) {
      const noun = visible === 1 ? status.dataset.one : status.dataset.many;
      status.textContent = `${visible} ${noun}${category ? ` ${status.dataset.inCategory} ${category}` : ""}`;
    }
    if (empty) empty.hidden = visible > 0;
  }
  if (controls) controls.hidden = false;
  filterFromUrl();
  select?.addEventListener("change", () => {
    const url = new URL(window.location.href);
    if (select.value) url.searchParams.set("category", select.value);
    else url.searchParams.delete("category");
    window.history.pushState(null, "", url);
    filterFromUrl();
  });
  window.addEventListener("popstate", filterFromUrl);
</script>
