---
import type { CollectionEntry } from "astro:content";
import { DEFAULT_LOCALE } from "@/i18n";
import { getPublishedDevlogs } from "@/lib/devlogs";
import DevlogPage from "@/views/DevlogPage.astro";

export async function getStaticPaths() {
  return (await getPublishedDevlogs(DEFAULT_LOCALE)).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<"devlogs">; }
const { post } = Astro.props;
---
<DevlogPage post={post} />
