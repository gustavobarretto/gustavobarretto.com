---
import { devlogUrl, getPublishedDevlogs } from "@/lib/devlogs";
import { DEFAULT_LOCALE } from "@/i18n";
export async function getStaticPaths() {
  return (await getPublishedDevlogs(DEFAULT_LOCALE)).map((post) => ({
    params: { slug: post.id },
    props: { destination: devlogUrl(post) },
  }));
}
return Astro.redirect(Astro.props.destination, 301);
---
