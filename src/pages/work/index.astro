---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WorkHighlights from "@/components/WorkHighlights.astro";
import { PROFILE, SITE } from "@/config";
import { getCollection } from "astro:content";

const work = (await getCollection("work"))
  .sort((a, b) => {
    const firstDate = a.data.date?.valueOf() ?? Number.NEGATIVE_INFINITY;
    const secondDate = b.data.date?.valueOf() ?? Number.NEGATIVE_INFINITY;
    return firstDate === secondDate ? a.id.localeCompare(b.id) : secondDate - firstDate;
  });
---
<BaseLayout title="Work" description="Selected work, professional experience, and personal projects by Gustavo Barretto.">
  <header class="profile">
    <div class="profile-name">
      <p class="profile-role">Software Engineer</p>
      <h1>{SITE.author}</h1>
    </div>
    <div class="profile-intro">
      <p>{PROFILE.intro}</p>
      <a href="/backstory">Read my backstory</a>
    </div>
  </header>

  <section class="work-section" aria-labelledby="work-heading">
    <h2 class="section-heading" id="work-heading">Work</h2>
    <ol class="work-list">
      {work.map(({ data }) => (
        <li class="work-entry">
          <article>
            <div class="work-row">
              <div class="work-meta">
                {data.period && <p class="work-period">{data.period}</p>}
                <p class="work-organization">
                  {data.organizationUrl ? (
                    <a href={data.organizationUrl} target="_blank" rel="noopener noreferrer">{data.organization}</a>
                  ) : data.organization}
                </p>
                <p class="work-kind">{data.kind === "experience" ? "Experience" : "Personal project"}</p>
              </div>
              <div>
                <h3 class="work-title">
                  {data.link ? <a href={data.link} target="_blank" rel="noopener noreferrer">{data.role ?? data.title}</a> : data.role ?? data.title}
                </h3>
                <div class="editorial-copy">
                  <p>{data.description}</p>
                  {data.details.map((paragraph) => <p>{paragraph}</p>)}
                  <WorkHighlights highlights={data.highlights} />
                </div>
                {data.linkSecondary && data.linkSecondaryLabel && (
                  <p class="work-links"><a href={data.linkSecondary} target="_blank" rel="noopener noreferrer">{data.linkSecondaryLabel}</a></p>
                )}
              </div>
            </div>
            {data.initiatives.length > 0 && (
              <ul class="work-initiatives">
                {data.initiatives.map((initiative) => (
                  <li class="work-row work-initiative">
                    <div class="work-submeta">
                      {initiative.period && <p class="work-period">{initiative.period}</p>}
                      <h4 class="work-subtitle">{initiative.title}</h4>
                    </div>
                    <div class="editorial-copy">
                      <p>{initiative.description}</p>
                      <WorkHighlights highlights={initiative.highlights} />
                      {initiative.reference && (
                        <p class="work-links"><a href={initiative.reference.url}>{initiative.reference.label}</a></p>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))}
    </ol>
    {work.length === 0 && <p class="empty-state">Work and projects will appear here.</p>}
  </section>
</BaseLayout>
