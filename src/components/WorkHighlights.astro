---
interface Props {
  highlights: Array<{ title: string; description: string }>;
}

const { highlights } = Astro.props;
---
{highlights.length > 0 && (
  <dl class="work-highlights">
    {highlights.map(({ title, description }) => (
      <div>
        <dt>{title}</dt>
        <dd>{description}</dd>
      </div>
    ))}
  </dl>
)}
