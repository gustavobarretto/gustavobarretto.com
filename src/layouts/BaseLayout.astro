---
import { NAV_LINKS, SITE, SOCIALS } from "@/config";
import "../styles/global.css";

interface Props { title: string; description?: string; }
const { title, description = SITE.desc } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3eb" />
    <title>{title ? `${title} · ${SITE.title}` : SITE.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Gustavo Barretto — Devlogs" href="/rss.xml" />
    <script is:inline>
      try {
        document.documentElement.classList.toggle("dark", localStorage.getItem("theme") === "dark");
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header-inner site-width">
          <a class="wordmark" href="/" aria-label="Gustavo Barretto — Home">
            <span class="monogram" aria-hidden="true">GB</span>
            <span>Gustavo Barretto</span>
          </a>
          <nav class="main-nav" aria-label="Main navigation">
            {NAV_LINKS.map((link) => (
              <a href={link.href} aria-current={pathname === link.href || pathname.startsWith(`${link.href}/`) ? "page" : undefined}>{link.label}</a>
            ))}
          </nav>
          <button type="button" id="theme-toggle" aria-label="Switch to dark mode" aria-pressed="false">
            <span class="theme-swatch" aria-hidden="true"></span><span id="theme-label">Dark mode</span>
          </button>
        </div>
      </header>
      <main id="main-content" tabindex="-1" class="main-content site-width">
        <slot />
      </main>
      <footer class="site-footer site-width">
        <div class="site-footer-inner">
          <small>© {new Date().getFullYear()} Gustavo Barretto</small>
          <ul class="social-links" aria-label="Find me elsewhere">
            {SOCIALS.map((social) => (
              <li><a href={social.href} target={social.icon === "mail" ? undefined : "_blank"} rel={social.icon === "mail" ? undefined : "noopener noreferrer"}>{social.name === "Twitter" ? "X" : social.name}</a></li>
            ))}
          </ul>
        </div>
      </footer>
    </div>
    <script>
      const toggle = document.getElementById("theme-toggle");
      const label = document.getElementById("theme-label");
      function updateThemeButton() {
        const dark = document.documentElement.classList.contains("dark");
        toggle?.setAttribute("aria-pressed", String(dark));
        toggle?.setAttribute("aria-label", `Switch to ${dark ? "light" : "dark"} mode`);
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#1a2421" : "#f6f3eb");
        if (label) label.textContent = dark ? "Light mode" : "Dark mode";
      }
      updateThemeButton();
      toggle?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
        updateThemeButton();
      });
    </script>
  </body>
</html>
