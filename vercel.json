{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    { "source": "/", "destination": "/devlogs", "permanent": true },
    { "source": "/projects", "destination": "/work", "permanent": true },
    { "source": "/about", "destination": "/backstory", "permanent": true },
    { "source": "/blog", "destination": "/devlogs", "permanent": true },
    { "source": "/blog/:path*", "destination": "/devlogs/:path*", "permanent": true }
  ]
}
